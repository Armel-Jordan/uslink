# Copy to `.env.local` and fill in. Without these the app runs in demo mode
# (local data on the device, scripted partner, no backend required).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never prefix with EXPO_PUBLIC_.
# Set it on Supabase, not here: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
